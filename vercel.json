{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "DATABASE_URL": {
      "description": "Neon PostgreSQL connection string with SSL"
    },
    "SOLANA_RPC_URL": {
      "description": "Solana RPC URL (Helius or public RPC)",
      "default": "https://api.devnet.solana.com"
    },
    "SOLANA_CLUSTER": {
      "description": "Solana cluster: devnet, testnet, or mainnet-beta",
      "default": "devnet"
    },
    "HELIUS_RPC_URL": {
      "description": "Helius RPC endpoint (free tier: 10M req/month)"
    },
    "CRON_SECRET": {
      "description": "Secret token for background job endpoint"
    }
  },
  "builds": [
    {
      "src": "packages/api/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/packages/api/$1"
    }
  ]
}
