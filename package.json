{
  "name": "blew",
  "version": "0.1.0",
  "description": "Payments at the speed of wind - Solana payment widget",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/api && npm run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules .turbo",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "cd packages/api && node scripts/sync-root-env.js && npx prisma studio"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.6"
  }
}
