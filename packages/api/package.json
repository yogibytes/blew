{
  "name": "@blew/api",
  "version": "0.1.0",
  "description": "Blew backend API (Next.js)",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-root-env.js",
    "dev": "next dev",
    "prebuild": "node scripts/sync-root-env.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "predb:migrate": "node scripts/sync-root-env.js",
    "db:migrate": "prisma migrate dev",
    "predb:push": "node scripts/sync-root-env.js",
    "db:push": "prisma db push",
    "predb:studio": "node scripts/sync-root-env.js",
    "db:studio": "prisma studio",
    "prestart": "node scripts/sync-root-env.js",
    "clean": "rm -rf .next dist .turbo"
  },
  "dependencies": {
    "@blew/types": "file:../types",
    "@prisma/client": "^5.8.0",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.87.0",
    "@types/express": "^4.17.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.4.31",
    "prisma": "^5.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
