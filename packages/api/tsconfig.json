{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./../",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@blew/types": [
        "../types/src/index.ts"
      ]
    },
    "jsx": "preserve",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": ".next",
    "noEmit": true,
    "incremental": true
  },
  "include": [
    "src/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
