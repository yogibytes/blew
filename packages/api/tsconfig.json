{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@blew/types": ["../types/src"]
    },
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": ".next"
  },
  "include": [
    "src/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
