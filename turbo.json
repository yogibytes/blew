{
  "$schema": "https://turbo.build/json-schema.json",
  "globalDependencies": [
    "**/package.json",
    "**/tsconfig.json"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
